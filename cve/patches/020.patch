Date: Wed, 28 Oct 2026 03:08:48 +0000
Subject: [PATCH] cve: tipc tipc_net_finalize rtnl_lock (CVE-2025-40280)

---
 net/tipc/net.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/net/tipc/net.c b/net/tipc/net.c
index 2498ce8b83c1..d0248fd70410 100644
--- a/net/tipc/net.c
+++ b/net/tipc/net.c
@@ -141,7 +141,9 @@ void tipc_net_finalize_work(struct work_struct *work)
 	struct tipc_net_work *fwork;
 
 	fwork = container_of(work, struct tipc_net_work, work);
+	rtnl_lock();
 	tipc_net_finalize(fwork->net, fwork->addr);
+	rtnl_unlock();
 }
 
 void tipc_sched_net_finalize(struct net *net, u32 addr)
