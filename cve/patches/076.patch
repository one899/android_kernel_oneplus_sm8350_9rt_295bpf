diff --git a/.github/cve/b5-manual.patch b/.github/cve/b5-manual.patch
index e287629c0734..c4d58fb45ac1 100644
--- a/.github/cve/b5-manual.patch
+++ b/.github/cve/b5-manual.patch
@@ -28,126 +28,6 @@ index e90a22e..ac4b747 100644
  }
  
  static int sd_suspend_runtime(struct device *dev)
-diff --git a/drivers/spi/spi.c b/drivers/spi/spi.c
-index afeb80f..9ee88f7 100644
---- a/drivers/spi/spi.c
-+++ b/drivers/spi/spi.c
-@@ -41,6 +41,8 @@ EXPORT_TRACEPOINT_SYMBOL(spi_transfer_stop);
- 
- #include "internals.h"
- 
-+static int __spi_setup(struct spi_device *spi, bool initial_setup);
-+
- static DEFINE_IDR(spi_master_idr);
- 
- static void spidev_release(struct device *dev)
-@@ -616,7 +618,7 @@ int spi_add_device(struct spi_device *spi)
- 	 * normally rely on the device being setup.  Devices
- 	 * using SPI_CS_HIGH can't coexist well otherwise...
- 	 */
--	status = spi_setup(spi);
-+	status = __spi_setup(spi, true);
- 	if (status < 0) {
- 		dev_err(dev, "can't setup %s, status %d\n",
- 				dev_name(&spi->dev), status);
-@@ -3111,27 +3113,7 @@ static int __spi_validate_bits_per_word(struct spi_controller *ctlr,
- 	return 0;
- }
- 
--/**
-- * spi_setup - setup SPI mode and clock rate
-- * @spi: the device whose settings are being modified
-- * Context: can sleep, and no requests are queued to the device
-- *
-- * SPI protocol drivers may need to update the transfer mode if the
-- * device doesn't work with its default.  They may likewise need
-- * to update clock rates or word sizes from initial values.  This function
-- * changes those settings, and must be called from a context that can sleep.
-- * Except for SPI_CS_HIGH, which takes effect immediately, the changes take
-- * effect the next time the device is selected and data is transferred to
-- * or from it.  When this function returns, the spi device is deselected.
-- *
-- * Note that this call will fail if the protocol driver specifies an option
-- * that the underlying controller or its driver does not support.  For
-- * example, not all hardware supports wire transfers using nine bit words,
-- * LSB-first wire encoding, or active-high chipselects.
-- *
-- * Return: zero on success, else a negative error code.
-- */
--int spi_setup(struct spi_device *spi)
-+static int __spi_setup(struct spi_device *spi, bool initial_setup)
- {
- 	unsigned	bad_bits, ugly_bits;
- 	int		status;
-@@ -3197,7 +3179,7 @@ int spi_setup(struct spi_device *spi)
- 			pm_runtime_put_noidle(spi->controller->dev.parent);
- 			dev_err(&spi->controller->dev, "Failed to power device: %d\n",
- 				status);
--			return status;
-+		goto err_cleanup;
- 		}
- 
- 		/*
-@@ -3229,7 +3211,7 @@ int spi_setup(struct spi_device *spi)
- 			spi->bits_per_word, spi->max_speed_hz,
- 			status);
- 
--	return status;
-+			goto err_cleanup;
- }
- EXPORT_SYMBOL_GPL(spi_setup);
- 
-@@ -3583,6 +3565,37 @@ static int __spi_sync(struct spi_device *spi, struct spi_message *message)
- 	}
- 	message->context = NULL;
- 	return status;
-+
-+err_cleanup:
-+	if (initial_setup)
-+		spi_cleanup(spi);
-+
-+	return status;
-+}
-+
-+/**
-+ * spi_setup - setup SPI mode and clock rate
-+ * @spi: the device whose settings are being modified
-+ * Context: can sleep, and no requests are queued to the device
-+ *
-+ * SPI protocol drivers may need to update the transfer mode if the
-+ * device doesn't work with its default.  They may likewise need
-+ * to update clock rates or word sizes from initial values.  This function
-+ * changes those settings, and must be called from a context that can sleep.
-+ * Except for SPI_CS_HIGH, which takes effect immediately, the changes take
-+ * effect the next time the device is selected and data is transferred to
-+ * or from it.  When this function returns, the SPI device is deselected.
-+ *
-+ * Note that this call will fail if the protocol driver specifies an option
-+ * that the underlying controller or its driver does not support.  For
-+ * example, not all hardware supports wire transfers using nine bit words,
-+ * LSB-first wire encoding, or active-high chipselects.
-+ *
-+ * Return: zero on success, else a negative error code.
-+ */
-+int spi_setup(struct spi_device *spi)
-+{
-+	return __spi_setup(spi, false);
- }
- 
- /**
-diff --git a/net/bluetooth/hci_core.c b/net/bluetooth/hci_core.c
-index d3862da..d3c354f 100644
---- a/net/bluetooth/hci_core.c
-+++ b/net/bluetooth/hci_core.c
-@@ -3415,6 +3415,8 @@ void hci_unregister_dev(struct hci_dev *hdev)
- 	cancel_work_sync(&hdev->tx_work);
- 	cancel_work_sync(&hdev->power_on);
- 	cancel_work_sync(&hdev->error_reset);
-+	cancel_delayed_work_sync(&hdev->cmd_timer);
-+	cancel_delayed_work_sync(&hdev->ncmd_timer);
- 
- 	hci_dev_do_close(hdev);
- 
 diff --git a/net/ipv4/esp4.c b/net/ipv4/esp4.c
 index 9a8f0e3..cfc61cd 100644
 --- a/net/ipv4/esp4.c
